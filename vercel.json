{
  "installCommand": "pnpm install --ignore-scripts && pnpm rebuild esbuild sharp",
  "buildCommand": "pnpm run build",
  "framework": "astro",
  "build": {
    "env": {
      "NODE_VERSION": "22"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "muzagrow.com" }],
      "destination": "https://www.muzagrow.com/$1",
      "permanent": true
    }
  ]
}
