---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Hero from '@/components/sections/Hero.astro';
import ValueProp from '@/components/sections/ValueProp.astro';
import Services from '@/components/sections/Services.astro';
import SocialProof from '@/components/sections/SocialProof.astro';
import WhyDesign from '@/components/sections/WhyDesign.astro';
import Process from '@/components/sections/Process.astro';
import CaseStudyInternal from '@/components/sections/CaseStudyInternal.astro';
import Clientes from '@/components/sections/Clientes.astro';
import WhoBuilds from '@/components/sections/WhoBuilds.astro';
import Garantia from '@/components/sections/Garantia.astro';
import BlogPreview from '@/components/sections/BlogPreview.astro';
import CTA from '@/components/sections/CTA.astro';
---

<BaseLayout
  title="Automatización Empresas LATAM - Reduce Costos 60% | MUZA GROW"
  description="Automatización de procesos + Service Design para empresas LATAM. Reduce procesos manuales 40-60%. Auditoría gratis con estimado exacto. Casos: Digital Tracking + LSAR Inox."
>
  <Header />
  <main>
    <Hero />
    <SocialProof />
    <ValueProp />
    <Services />
    <WhyDesign />

    <!-- Manifesto section -->
    <section
      id="manifesto"
      style="background:rgba(255,255,255,0.02);padding:clamp(3rem,6vw,5rem) var(--px);border-top:1px solid var(--bdr);border-bottom:1px solid var(--bdr);position:relative;overflow:hidden;z-index:2;"
      aria-labelledby="man-h"
    >
      <!-- Animated tape lines -->
      <div style="position:absolute;left:-5%;right:-5%;height:2px;background:linear-gradient(90deg,transparent,var(--teal),var(--coral),var(--gold),transparent);background-size:200% 100%;animation:holo 4s ease infinite;top:9%;transform:rotate(-.4deg);" aria-hidden="true"></div>
      <div style="position:absolute;left:-5%;right:-5%;height:2px;background:linear-gradient(90deg,transparent,var(--teal),var(--coral),var(--gold),transparent);background-size:200% 100%;animation:holo 4s ease infinite;bottom:11%;transform:rotate(.35deg);" aria-hidden="true"></div>

      <!-- Quote mark -->
      <div style="position:absolute;top:-2rem;left:4vw;font-family:var(--ser);font-size:16vw;color:rgba(255,255,255,.03);pointer-events:none;user-select:none;line-height:1;" aria-hidden="true">"</div>

      <div style="position:relative;z-index:1;max-width:1100px;margin:0 auto;">
        <div class="s-tag">// Manifiesto</div>
        <h2 id="man-h" style="font-family:var(--body);font-weight:800;letter-spacing:-.02em;line-height:1.1;">
          <span style="font-size:clamp(1.6rem,3.2vw,3.2rem);color:var(--white);display:block;">TU NEGOCIO CRECE.</span>
          <span style="font-family:var(--ser);font-size:clamp(1.6rem,3.2vw,3.2rem);color:var(--gr);font-weight:400;font-style:italic;display:block;">tu operación, no tanto.</span>
          <div style="width:48px;height:1px;background:var(--teal);margin:1.2rem 0;" aria-hidden="true"></div>
          <span style="font-size:clamp(1.6rem,3.2vw,3.2rem);color:var(--gold);display:block;">CADA HORA MANUAL QUE CONSUMES</span>
          <span style="font-family:var(--ser);font-size:clamp(1.6rem,3.2vw,3.2rem);color:var(--white);font-weight:400;font-style:italic;display:block;">es una hora que <em style="color:var(--coral);font-style:normal;font-weight:800;">no escalas.</em></span>
        </h2>
        <div style="height:1.5rem;" aria-hidden="true"></div>
        <p style="font-family:var(--body);font-size:clamp(.9rem,1.1vw,1rem);color:rgba(255,255,255,.7);font-weight:400;display:block;margin-bottom:.4rem;">Eso es exactamente lo que venimos a cambiar.</p>
        <p style="font-family:var(--body);font-size:clamp(.9rem,1.1vw,1rem);color:var(--white);font-weight:600;display:block;margin-bottom:.4rem;">Automatización real. Sistemas que trabajan cuando tú duermes.</p>
        <p style="font-family:var(--ser);font-size:clamp(.85rem,1vw,.95rem);color:var(--gr);font-style:italic;">Sin excusas. Sin límites. Con resultados.</p>
      </div>
    </section>

    <Process />
    <CaseStudyInternal />
    <Clientes />
    <BlogPreview />

    <!-- FAQ section -->
    <section class="section" id="faq" aria-labelledby="faq-h">
      <div class="faq-layout">
        <div>
          <div class="s-tag">Preguntas frecuentes</div>
          <h2 class="s-headline" id="faq-h" style="margin-bottom:1.5rem">
            Automatización de procesos:<br><em>preguntas frecuentes.</em>
          </h2>
          <p style="font-family:var(--body);font-size:.93rem;color:var(--gr);line-height:1.75;margin-top:.5rem;margin-bottom:1rem;">
            Si tienes una duda que no está aquí, escríbenos directamente. Respondemos en menos de 24h.
          </p>
          <a
            href="/servicios"
            style="font-family:var(--mono);font-size:.58rem;color:var(--teal);letter-spacing:.12em;text-decoration:none;text-transform:uppercase;display:block;margin-bottom:1.2rem;transition:letter-spacing .2s;"
          >
            Ver soluciones de automatización →
          </a>
          <a
            href="mailto:hola@muzagrow.com"
            style="font-family:var(--mono);font-size:.6rem;font-weight:700;letter-spacing:.16em;color:#000;background:var(--white);text-decoration:none;padding:.55rem 1.4rem;border-radius:20px;display:inline-block;transition:box-shadow .2s;"
          >
            Escribir al equipo
          </a>
        </div>

        <div class="faq-list">
          {[
            {
              q: '¿Cuánto ahorro al reducir costos con automatización de procesos?',
              a: 'Nuestros clientes reportan reducciones de 40-60% en procesos manuales. El ahorro exacto se calcula durante la auditoría gratuita. Casos verificados: Digital Tracking (crecimiento con presencia digital) y LSAR Inox (automatización de procesos operacionales).',
            },
            {
              q: '¿Qué diferencia hay entre Service Design y solo automatizar?',
              a: 'Automatizar sin diseñar es acelerar procesos rotos — el caos llega más rápido. Service Design primero significa mapear, rediseñar y luego automatizar. El resultado: infraestructura escalable que no colapsa cuando creces 3x.',
            },
            {
              q: '¿Cuál es mejor para empresas LATAM: Zapier, Make o n8n?',
              a: 'Depende de tu caso. Zapier: fácil de usar pero caro a escala. Make: buen balance entre poder y usabilidad. n8n: máximo control, código abierto y sin costos por ejecución — ideal para empresas LATAM que necesitan escalar sin disparar el presupuesto.',
            },
            {
              q: '¿Cuánto tiempo toma automatizar procesos manuales?',
              a: 'Diagnóstico: 3–5 días. Diseño de flujos: 1–2 semanas. Build e implementación: 2–8 semanas según complejidad. La mayoría de nuestros clientes tiene su primer sistema activo y generando ROI en menos de 30 días.',
            },
            {
              q: '¿Qué diferencia a MUZA de otras agencias de automatización?',
              a: 'Otros hacen "automatización" (conectan herramientas). Nosotros diseñamos infraestructura completa. Antes de escribir código, mapeamos tu proceso entero. Por eso las soluciones escalan cuando creces 3x. El diferenciador no son las herramientas — es el proceso.',
            },
            {
              q: '¿Cuánto tiempo tarda de principio a fin?',
              a: 'Discovery: 3-5 días. Diseño: 1-2 semanas. Build: 2-8 semanas (depende de complejidad). Optimization: ongoing. Timeline total: 5-15 semanas si haces todo el proceso.',
            },
            {
              q: '¿Qué pasa si hacemos Discovery pero decidimos no continuar con Build?',
              a: 'El Discovery ya tiene valor por sí mismo. Obtienes el strategy document y roadmap ejecutable. Lo puedes ejecutar tú mismo si prefieres. La mayoría nos contrata para el Build después porque entienden la arquitectura y validaron que somos fit.',
            },
            {
              q: '¿Cómo es el soporte después de que lancemos?',
              a: 'No es "entrega y desaparece". Todos los proyectos incluyen monitoreo de performance, iteración por métricas, soporte técnico post-deploy y mejoras conforme tu negocio crece. Eres nuestro cliente de largo plazo.',
            },
            {
              q: '¿Por qué algunas agencias son más baratas?',
              a: 'Nos enfocamos en calidad y accountability. Equipo pequeño, cada proyecto es responsabilidad personal. Rechazamos proyectos que no podemos hacer bien. Agencias grandes aceptan más proyectos con menos atención. Precios bajos = juniors, menos accountability. Elige qué importa: precio bajo o resultados probados.',
            },
            {
              q: '¿Qué tecnologías usan?',
              a: 'n8n (orquestación de workflows), Claude + OpenAI (IA para reasoning complejo), Notion o Google Workspace (data management), WhatsApp + Slack (comunicación), Vercel (hosting). Cada proyecto define el stack exacto — no hay stack fijo.',
            },
            {
              q: '¿Puedo ver casos de estudio?',
              a: 'Después de confirmar el diagnóstico, compartimos 1-2 casos reales con permiso del cliente. Incluyen nombres, resultados exactos y la arquitectura que usamos. No los publicamos abiertamente para proteger la privacidad de los clientes.',
            },
          ].map((item, i) => (
            <div class="faq-item">
              <button class="faq-btn" aria-expanded="false" aria-controls={`fa-${i}`}>
                <span>{item.q}</span>
                <span class="faq-icon">+</span>
              </button>
              <div class="faq-body" id={`fa-${i}`}>
                <p>{item.a}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <WhoBuilds />
    <Garantia />
    <CTA />
  </main>
  <Footer />
</BaseLayout>

<script type="application/ld+json" is:inline>
[
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Auditoría de Procesos para Automatización — Growth Architecture Discovery",
    "description": "Mapeamos tu operación completa e identificamos dónde se pierden horas y costos. Resultado: strategy document con roadmap de automatización ejecutable.",
    "provider": { "@type": "LocalBusiness", "name": "MUZA GROW", "url": "https://www.muzagrow.com" },
    "areaServed": ["MX","CO","AR","CL","PE"],
    "serviceType": "Consultoría de Automatización de Procesos"
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Automatización con n8n — Automation Design & Build",
    "description": "Diseñamos y construimos flujos de automatización con n8n, agentes IA e integraciones. Sistemas que operan 24/7 y reducen costos operacionales 60-70%.",
    "provider": { "@type": "LocalBusiness", "name": "MUZA GROW", "url": "https://www.muzagrow.com" },
    "areaServed": ["MX","CO","AR","CL","PE"],
    "serviceType": "Automatización de Procesos con n8n e IA"
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Optimización Continua de Procesos — Ongoing Optimization & ROI",
    "description": "Monitoreamos, iteramos y mejoramos sistemas automatizados basado en métricas reales. ROI medible y reducción de costos operacionales comprobada.",
    "provider": { "@type": "LocalBusiness", "name": "MUZA GROW", "url": "https://www.muzagrow.com" },
    "areaServed": ["MX","CO","AR","CL","PE"],
    "serviceType": "Optimización de Procesos Empresariales"
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Moises",
    "jobTitle": "Founder & Service Designer",
    "description": "Especialista en Service Design y automatización de procesos para empresas LATAM.",
    "worksFor": { "@type": "Organization", "name": "MUZA GROW", "url": "https://www.muzagrow.com" },
    "url": "https://www.muzagrow.com/nosotros"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "¿Cuánto ahorro al reducir costos con automatización de procesos?",
        "acceptedAnswer": { "@type": "Answer", "text": "Nuestros clientes reportan reducciones de 40-60% en procesos manuales. El ahorro exacto se calcula en la auditoría gratuita. Casos: Digital Tracking y LSAR Inox." }
      },
      {
        "@type": "Question",
        "name": "¿Qué diferencia hay entre Service Design y solo automatizar?",
        "acceptedAnswer": { "@type": "Answer", "text": "Automatizar sin diseñar es acelerar procesos rotos. Service Design primero significa mapear, rediseñar y luego automatizar. El resultado es infraestructura escalable que no colapsa cuando creces 3x." }
      },
      {
        "@type": "Question",
        "name": "¿Cuál es mejor para empresas LATAM: Zapier, Make o n8n?",
        "acceptedAnswer": { "@type": "Answer", "text": "Zapier es fácil pero caro a escala. Make ofrece buen balance. n8n es ideal para empresas LATAM: código abierto, sin costos por ejecución y máximo control." }
      },
      {
        "@type": "Question",
        "name": "¿Cuánto tiempo toma automatizar procesos manuales?",
        "acceptedAnswer": { "@type": "Answer", "text": "Diagnóstico: 3–5 días. Diseño de flujos: 1–2 semanas. Build e implementación: 2–8 semanas según complejidad. La mayoría de clientes tiene su primer sistema activo en menos de 30 días." }
      },
      {
        "@type": "Question",
        "name": "¿Necesito un equipo técnico propio para implementar automatización?",
        "acceptedAnswer": { "@type": "Answer", "text": "No. Diseñamos, construimos y mantenemos toda la infraestructura de automatización. Solo necesitas saber qué resultados quieres — nosotros construimos el camino." }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.muzagrow.com" },
      { "@type": "ListItem", "position": 2, "name": "Automatización de Procesos", "item": "https://www.muzagrow.com/servicios" },
      { "@type": "ListItem", "position": 3, "name": "Blog", "item": "https://www.muzagrow.com/blog" }
    ]
  }
]
</script>

<script>
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('.faq-btn').forEach(b => {
        b.setAttribute('aria-expanded', 'false');
        const bd = document.getElementById(b.getAttribute('aria-controls')!);
        if (bd) bd.classList.remove('open');
      });
      if (!open) {
        const ans = document.getElementById(btn.getAttribute('aria-controls')!);
        btn.setAttribute('aria-expanded', 'true');
        if (ans) ans.classList.add('open');
      }
    });
  });
</script>
