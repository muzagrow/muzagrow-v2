---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Button from '@/components/ui/Button.astro';
import { TOOLS } from '@/lib/constants';
---

<BaseLayout
  title="Nosotros | MUZA GROW"
  description="Service Design + Automatización IA para corporativos en LATAM. Conoce la historia y filosofía detrás de MUZA GROW."
>
  <Header />
  <main style="padding-top:5rem;">

    <!-- Hero -->
    <section class="section nos-hero">
      <div class="s-tag">Quiénes somos</div>
      <h1 class="s-headline">
        Service Design<br><em>para operaciones que escalan.</em>
      </h1>
      <p class="nos-intro">
        MUZA GROW nació de una convicción: las empresas en LATAM tienen los equipos,
        la visión y el mercado — pero sus operaciones no escalan al mismo ritmo.
      </p>
      <p class="nos-intro nos-intro--bold">
        No vendemos "automatización". Diseñamos la infraestructura operacional
        que permite que tu empresa crezca sin fricciones.
      </p>

      <div class="nos-stats">
        {[
          { num: '300%+', label: 'ROI promedio', sub: 'en proyectos completados' },
          { num: '48h',   label: 'Primer entregable', sub: 'desde kickoff' },
          { num: '12x',   label: 'Velocidad operativa', sub: 'vs. procesos manuales' },
        ].map(s => (
          <div class="nos-stat">
            <div class="nos-stat-num">{s.num}</div>
            <div class="nos-stat-label">{s.label}</div>
            <div class="nos-stat-sub">{s.sub}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Philosophy -->
    <section class="section" style="padding-top:0;">
      <div class="s-tag">Filosofía</div>
      <h2 class="s-headline">Lo que nos guía<br><em>en cada proyecto.</em></h2>

      <div class="nos-principles">
        {[
          {
            num: '01',
            title: 'Service Designer primero',
            desc: 'Entendemos el problema antes de proponer soluciones. Diseñamos sistemas, no solo flujos.',
          },
          {
            num: '02',
            title: 'Resultados sobre herramientas',
            desc: 'No vendemos n8n ni IA. Vendemos el resultado de usarlos bien. La herramienta es el medio, no el fin.',
          },
          {
            num: '03',
            title: 'El fundador habla directo contigo',
            desc: 'Sin intermediarios, sin ventas de alta presión. Conversación real con quien va a construirlo.',
          },
          {
            num: '04',
            title: 'Honestidad sobre viabilidad',
            desc: 'Si algo no tiene sentido construirlo, te lo decimos. Preferimos una relación honesta a un proyecto mal enfocado.',
          },
          {
            num: '05',
            title: 'Cada cliente enseña algo',
            desc: 'Cada proyecto es una oportunidad de mejorar. Documentamos lo que aprendemos y lo aplicamos al siguiente.',
          },
          {
            num: '06',
            title: 'Métricas reales, no vanidad',
            desc: 'Medimos lo que importa: horas ahorradas, costos reducidos, ingresos aumentados. No "deploys" ni "sprints".',
          },
        ].map(item => (
          <div class="card nos-principle">
            <div class="nos-p-num">{item.num}</div>
            <h3 class="nos-p-title">{item.title}</h3>
            <p class="nos-p-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Metodología -->
    <section class="section" style="padding-top:0;">
      <div class="s-tag">Metodología</div>
      <h2 class="s-headline">Cómo operamos<br><em>en cada proyecto.</em></h2>

      <div class="nos-method-grid">
        <div class="nos-method-card nos-method-card--accent">
          <div class="nos-m-icon">🔍</div>
          <h3 class="nos-m-title">Aprender haciendo</h3>
          <p class="nos-m-desc">
            Cada proyecto es un caso de estudio real. Lo que construimos contigo
            también refina nuestro proceso para el siguiente cliente.
          </p>
        </div>
        <div class="nos-method-card">
          <div class="nos-m-icon">📐</div>
          <h3 class="nos-m-title">Diseño antes de código</h3>
          <p class="nos-m-desc">
            Ningún proyecto empieza sin un strategy document aprobado.
            Construir sin diseño previo es desperdiciar presupuesto.
          </p>
        </div>
        <div class="nos-method-card">
          <div class="nos-m-icon">📊</div>
          <h3 class="nos-m-title">ROI medible</h3>
          <p class="nos-m-desc">
            Todo sistema que construimos incluye métricas de éxito definidas desde el inicio.
            Si no es medible, no lo entregamos.
          </p>
        </div>
        <div class="nos-method-card">
          <div class="nos-m-icon">🔧</div>
          <h3 class="nos-m-title">Soporte post-launch</h3>
          <p class="nos-m-desc">
            No es entrega y desaparece. Todos los proyectos incluyen soporte técnico
            y documentación para que tu equipo lo opere.
          </p>
        </div>
      </div>
    </section>

    <!-- Stack -->
    <section class="section" style="padding-top:0;padding-bottom:5rem;">
      <div class="s-tag">Stack</div>
      <h2 class="s-headline" style="margin-bottom:2rem;">Herramientas<br><em>que dominamos.</em></h2>
      <div class="nos-tools">
        {TOOLS.map(t => (
          <div class="nos-tool">{t}</div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="section nos-cta">
      <h2 class="s-headline nos-cta-h">Trabajemos juntos</h2>
      <p class="nos-cta-sub">
        Una conversación sin compromiso. Entendemos tu problema antes de proponer cualquier solución.
      </p>
      <Button href="/contacto" size="lg">Contáctanos</Button>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
/* Hero */
.nos-hero { padding-top: 4rem; padding-bottom: 4rem; }

.nos-intro {
  font-family: var(--body);
  font-size: 1.05rem;
  color: var(--gr);
  line-height: 1.75;
  max-width: 640px;
  margin-bottom: 1rem;
}
.nos-intro--bold { color: var(--white); margin-bottom: 3rem; }

.nos-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--bdr);
  border: 1px solid var(--bdr);
  border-radius: 1.25rem;
  overflow: hidden;
  max-width: 560px;
}
.nos-stat {
  background: var(--s1);
  padding: 1.4rem 1.6rem;
  text-align: center;
}
.nos-stat-num {
  font-family: var(--mono);
  font-size: clamp(1.3rem, 2.5vw, 1.8rem);
  font-weight: 700;
  color: var(--teal);
  line-height: 1;
}
.nos-stat-label {
  font-family: var(--mono);
  font-size: .48rem;
  color: var(--gr);
  letter-spacing: .1em;
  text-transform: uppercase;
  margin-top: .4rem;
}
.nos-stat-sub {
  font-family: var(--body);
  font-size: .72rem;
  color: rgba(143,144,166,.6);
  margin-top: .2rem;
  line-height: 1.3;
}

/* Philosophy */
.nos-principles {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.2rem;
}
@media (max-width: 860px) { .nos-principles { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 560px) { .nos-principles { grid-template-columns: 1fr; } }

.nos-principle { display: flex; flex-direction: column; gap: .6rem; }

.nos-p-num {
  font-family: var(--mono);
  font-size: .52rem;
  font-weight: 700;
  color: var(--teal);
  letter-spacing: .18em;
}
.nos-p-title {
  font-family: var(--body);
  font-size: 1rem;
  font-weight: 700;
  color: var(--white);
  line-height: 1.3;
}
.nos-p-desc {
  font-family: var(--body);
  font-size: .88rem;
  color: var(--gr);
  line-height: 1.65;
}

/* Metodología */
.nos-method-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.2rem;
}
@media (max-width: 640px) { .nos-method-grid { grid-template-columns: 1fr; } }

.nos-method-card {
  background: var(--s1);
  border: 1px solid var(--bdr);
  border-radius: 1.25rem;
  padding: 2rem;
  display: flex;
  flex-direction: column;
  gap: .75rem;
  transition: border-color .25s;
}
.nos-method-card:hover { border-color: var(--bdr-g); }
.nos-method-card--accent {
  background: rgba(0,168,143,.04);
  border-color: rgba(0,168,143,.2);
}

.nos-m-icon { font-size: 1.6rem; line-height: 1; }
.nos-m-title {
  font-family: var(--body);
  font-size: 1rem;
  font-weight: 700;
  color: var(--white);
}
.nos-m-desc {
  font-family: var(--body);
  font-size: .88rem;
  color: var(--gr);
  line-height: 1.65;
}

/* Stack */
.nos-tools {
  display: flex;
  flex-wrap: wrap;
  gap: .55rem;
}
.nos-tool {
  font-family: var(--mono);
  font-size: .62rem;
  color: var(--gr);
  background: var(--s2);
  border: 1px solid var(--bdr);
  padding: .45rem 1rem;
  border-radius: 20px;
  letter-spacing: .05em;
  transition: color .2s, border-color .2s;
  cursor: default;
}
.nos-tool:hover { color: var(--white); border-color: var(--bdr-g); }

/* CTA */
.nos-cta {
  text-align: center;
  padding-bottom: 6rem;
  position: relative;
  z-index: 2;
}
.nos-cta-h { margin-bottom: 1rem; }
.nos-cta-sub {
  font-family: var(--body);
  font-size: 1rem;
  color: var(--gr);
  max-width: 480px;
  margin: 0 auto 2rem;
  line-height: 1.7;
}
</style>
