---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
}

const SITE_URL = (Astro.site?.href ?? 'https://www.muzagrow.com').replace(/\/$/, '');
const DEFAULT_DESC = 'Automatización de procesos + Service Design para empresas LATAM. Reduce procesos manuales 40-60%. Auditoría gratis con estimado exacto. Casos: Digital Tracking + LSAR Inox.';
const DEFAULT_IMG = `${SITE_URL}/og-image.png`;

const {
  title = 'Automatización Empresas LATAM - Reduce Costos 60% | MUZA GROW',
  description = DEFAULT_DESC,
  image = DEFAULT_IMG,
  canonical = SITE_URL + Astro.url.pathname,
  type = 'website',
} = Astro.props;

const fullTitle = title.includes('MUZA GROW') ? title : `${title} | MUZA GROW`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonical} />

<!-- Open Graph -->
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="MUZA GROW" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

<!-- JSON-LD Organization -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "MUZA GROW",
  "url": SITE_URL,
  "description": DEFAULT_DESC,
  "email": "hola@muzagrow.com",
  "image": DEFAULT_IMG,
  "priceRange": "$$$",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Ciudad de México",
    "addressCountry": "MX"
  },
  "areaServed": ["MX", "CO", "AR", "CL", "PE"],
  "sameAs": ["https://linkedin.com/company/muza-grow"]
})} />
