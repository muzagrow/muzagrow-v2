---
---

<section class="section clientes-section" aria-labelledby="cli-h">
  <div class="s-tag">// Proyectos entregados</div>
  <h2 class="s-headline" id="cli-h">
    Empresas que ya<br><em>trabajan con nosotros.</em>
  </h2>

  <div class="cli-grid">
    {[
      {
        num: '01',
        company: 'Digital Tracking',
        industry: 'Publicidad Digital',
        tags: ['Web design', 'UX', 'Presencia digital'],
        desc: 'Agencia de publicidad digital con presencia en CTV, video y DOOH. Clientes como Coca-Cola, BMW y Heineken. Diseñamos y construimos su plataforma web para reflejar la escala de sus operaciones.',
        href: 'https://digitaltracking.mx/',
        accent: 'teal',
      },
      {
        num: '02',
        company: 'LSAR Inox',
        industry: 'Distribución Industrial',
        tags: ['Catálogo digital', 'Web design', 'B2B'],
        desc: 'Distribuidor de acero inoxidable con servicio de corte láser y entregas en 24-48h. Construimos su presencia digital para agilizar cotizaciones y presentar su catálogo industrial.',
        href: 'https://lsarinox.com.mx/',
        accent: 'gold',
      },
    ].map(item => (
      <div class={`cli-card cli-card--${item.accent}`}>
        <div class="cli-top">
          <span class="cli-num">{item.num}</span>
          <span class="cli-industry">{item.industry}</span>
        </div>
        <h3 class="cli-name">{item.company}</h3>
        <p class="cli-desc">{item.desc}</p>
        <div class="cli-tags">
          {item.tags.map(t => (
            <span class="cli-tag">{t}</span>
          ))}
        </div>
        <a href={item.href} target="_blank" rel="noopener noreferrer" class="cli-link">
          Ver proyecto →
        </a>
      </div>
    ))}
  </div>
</section>

<style>
.clientes-section {
  border-top: 1px solid var(--bdr);
}

.cli-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 1.5rem;
  margin-top: 2.5rem;
}

.cli-card {
  background: var(--s1);
  border: 1px solid var(--bdr);
  border-radius: 1.5rem;
  padding: 2rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  transition: border-color .25s, transform .25s;
}
.cli-card:hover { transform: translateY(-3px); }
.cli-card--teal:hover { border-color: rgba(0,168,143,.4); }
.cli-card--gold:hover  { border-color: rgba(243,198,99,.4); }

.cli-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.cli-num {
  font-family: var(--mono);
  font-size: .55rem;
  letter-spacing: .18em;
  color: var(--gr);
}
.cli-industry {
  font-family: var(--mono);
  font-size: .52rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--gr);
  background: rgba(255,255,255,.05);
  border: 1px solid var(--bdr);
  padding: .25rem .7rem;
  border-radius: 2rem;
}

.cli-name {
  font-family: var(--body);
  font-size: 1.5rem;
  font-weight: 800;
  letter-spacing: -.02em;
  color: var(--white);
  margin: 0;
}

.cli-desc {
  font-family: var(--body);
  font-size: .88rem;
  color: var(--gr);
  line-height: 1.7;
  flex: 1;
}

.cli-tags {
  display: flex;
  flex-wrap: wrap;
  gap: .5rem;
}
.cli-tag {
  font-family: var(--mono);
  font-size: .5rem;
  letter-spacing: .1em;
  color: var(--gr);
  border: 1px solid var(--bdr);
  padding: .2rem .6rem;
  border-radius: 1rem;
}

.cli-link {
  font-family: var(--mono);
  font-size: .6rem;
  letter-spacing: .12em;
  font-weight: 700;
  color: var(--accent);
  text-decoration: none;
  transition: color .2s;
  margin-top: .25rem;
}
.cli-link:hover { color: var(--white); }
</style>
