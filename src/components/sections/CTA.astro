---
import { SITE } from '@/lib/constants';
---

<section id="contact" style="padding:clamp(4rem,10vw,10rem) var(--px);text-align:center;position:relative;z-index:2;overflow:hidden;">
  <!-- Glow -->
  <div style="content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:min(600px,90vw);height:min(600px,90vw);background:radial-gradient(circle,rgba(238,118,93,.05) 0%,transparent 70%);border-radius:50%;pointer-events:none;" aria-hidden="true"></div>

  <div style="position:relative;z-index:1;max-width:640px;margin:0 auto;">
    <div class="s-tag cta-tag" style="justify-content:center;margin-bottom:1.8rem;">// Siguiente paso</div>

    <h2 style="font-family:var(--body);font-weight:800;font-size:clamp(2.4rem,7vw,6rem);letter-spacing:-.03em;line-height:.95;margin-bottom:.6rem;">
      AUDITORÍA GRATIS<br>
      <em class="holo-text" style="font-family:var(--ser);font-style:italic;font-weight:400;">(30 minutos)</em>
    </h2>

    <p style="font-family:var(--body);font-size:1rem;color:var(--gr);line-height:1.75;margin:1.2rem auto 2.8rem;max-width:480px;">
      Conversación directa — sin formularios infinitos, sin ventas de alta presión. Identificamos dónde se está perdiendo tiempo y dinero en tu operación. Sin costo, sin compromiso.
    </p>

    <div class="cc-stack">
      <a href={`mailto:${SITE.email}?subject=Quiero%20mi%20auditoría%20gratuita&body=Hola%2C%20me%20interesa%20la%20auditoría%20gratuita%20de%2030%20minutos.%20Mi%20empresa%20hace%3A%20`} class="cc primary">
        <div class="cc-icon">✉️</div>
        <div class="cc-body">
          <div class="cc-title">Escribir al equipo ahora</div>
          <div class="cc-desc">{SITE.email} — respuesta en menos de 24h</div>
        </div>
        <div class="cc-arr">→</div>
      </a>

      <a href="/contacto" class="cc">
        <div class="cc-icon">📋</div>
        <div class="cc-body">
          <div class="cc-title">Formulario detallado</div>
          <div class="cc-desc">Cuéntanos tu desafío completo — descripción + presupuesto</div>
        </div>
        <div class="cc-arr">→</div>
      </a>

      {SITE.whatsapp && (
        <a href={SITE.whatsapp} class="cc" target="_blank" rel="noopener noreferrer">
          <div class="cc-icon">💬</div>
          <div class="cc-body">
            <div class="cc-title">WhatsApp directo</div>
            <div class="cc-desc">Respuesta en menos de 2h en horario CDMX</div>
          </div>
          <div class="cc-arr">→</div>
        </a>
      )}
    </div>

    <p style="font-family:var(--mono);font-size:.58rem;color:var(--gr-d);letter-spacing:.1em;">
      // Sin contratos largos. Sin costos ocultos. Solo resultados.
    </p>
  </div>
</section>
